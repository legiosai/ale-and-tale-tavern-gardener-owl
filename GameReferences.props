<Project>
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DebugType>portable</DebugType>
  </PropertyGroup>
  <Target Name="ValidateGameReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(GameManagedDir)/Assembly-CSharp.dll')" Text="Set GameManagedDir to the game's Ale and Tale Tavern_Data/Managed directory." />
    <Error Condition="!Exists('$(BepInExCoreDir)/BepInEx.dll')" Text="Set BepInExCoreDir to the BepInEx 5 core directory." />
  </Target>
  <ItemGroup>
    <Reference Include="Assembly-CSharp" HintPath="$(GameManagedDir)/Assembly-CSharp.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(GameManagedDir)/UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(GameManagedDir)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.AIModule" HintPath="$(GameManagedDir)/UnityEngine.AIModule.dll" Private="false" />
    <Reference Include="UnityEngine.AnimationModule" HintPath="$(GameManagedDir)/UnityEngine.AnimationModule.dll" Private="false" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(GameManagedDir)/UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(GameManagedDir)/UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(GameManagedDir)/UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="Unity.Netcode.Runtime" HintPath="$(GameManagedDir)/Unity.Netcode.Runtime.dll" Private="false" />
    <Reference Include="Unity.Netcode.Components" HintPath="$(GameManagedDir)/Unity.Netcode.Components.dll" Private="false" />
    <Reference Include="Unity.Localization" HintPath="$(GameManagedDir)/Unity.Localization.dll" Private="false" />
    <Reference Include="Unity.Collections" HintPath="$(GameManagedDir)/Unity.Collections.dll" Private="false" />
    <Reference Include="Unity.Networking.Transport" HintPath="$(GameManagedDir)/Unity.Networking.Transport.dll" Private="false" />
    <Reference Include="DOTween" HintPath="$(GameManagedDir)/DOTween.dll" Private="false" />
    <Reference Include="Newtonsoft.Json" HintPath="$(GameManagedDir)/Newtonsoft.Json.dll" Private="false" />
    <Reference Include="BepInEx" HintPath="$(BepInExCoreDir)/BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(BepInExCoreDir)/0Harmony.dll" Private="false" />
  </ItemGroup>
</Project>
